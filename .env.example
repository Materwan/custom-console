# Copy this file to `.env`. Every variable is optional unless stated otherwise;
# empty values are treated as "not set" and fall back to the default.

# --- reMarkable (required only to use the reMarkable backend) -----------------
# Full path to rmapi.exe
RMAPI_PATH=
# Where `cp -r reMarkable:/... <dir>` style syncs are stored (default: <data>/reMarkable_sync)
REMARKABLE_SYNC_PATH=

# --- Layout --------------------------------------------------------------------
# Root folder for logs, agent memory, usage ledger, undo checkpoints, caches (default: <project>/data)
DATA_DIR=
# Name of the WSL distribution exposed as "/wsl-<name>/" (default: Ubuntu)
WSL_DISTRO=Ubuntu

# --- The Clara server ------------------------------------------------------------
# The agent is a client of the Clara server, which runs the model, the memory and the
# conversations. The tools (files, shell, PDF, Moodle, mail...) still run on this computer.
CLARA_URL=http://127.0.0.1:8765
# How `ai agent` signs in. Best: your user on the server and its password (the administrator makes it with
# /user add). The server then knows who you are, and the console's conversations are yours on every device.
CLARA_USER=
CLARA_PASSWORD=
# Or, without a user: a chat token (an entry of CLARA_TOKENS in the server's .env), which lets this program
# claim any identity. Use only if you have no user account (with both set, a token the server does not know
# costs a refused attempt at each start, then the console signs in with the password).
CLARA_TOKEN=
# Optional: the server's remote-admin token (CLARA_ADMIN_TOKENS there). It lets /model and /provider
# run in the server's console. Not needed when CLARA_USER is an administrator.
CLARA_ADMIN_TOKEN=
# How Clara should call you
CLARA_USER_NAME=Monsieur

# --- Local Ollama (only for `ai list` and `ai start`; the agent does not use it) -------
OLLAMA_HOST=http://localhost:11434
# Model `ai start` loads when none is given
AGENT_DEFAULT_MODEL=gemma4

# --- Agent ---------------------------------------------------------------------
# System prompt of the agent (default: <project>/config/agent_instructions.txt)
AGENT_INSTRUCTIONS_PATH=
# Tools needing a permission level <= this value are accepted without asking.
#   0 = always ask (except trivial tools)   1 = auto-accept reads   2 = auto-accept everything
AGENT_PERMISSION_LEVEL=1
# The folder the agent is started in (and its subfolders) is a free zone: file tools never
# ask there, whatever the level above.
AGENT_USER_ID=default_user
# Name of the conversations on the Clara server: console:<user>:<this>-<session number>
AGENT_SESSION_ID=console_session
# Project instructions file, read from the root of the free zone at every turn
AGENT_PROJECT_FILE=AGENT.md
# Saved sessions kept per working directory, for /restore
AGENT_KEEP_SESSIONS=5

# --- Moodle tools --------------------------------------------------------------
MOODLE_ENABLED=true
MOODLE_BASE_URL=https://moodle.epita.fr
# Playwright storage state (session cookies). Default: <project>/config/cookies/moodle_state.json
MOODLE_STATE_PATH=

# --- Email tool (registered only when SMTP_HOST is set) ------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
