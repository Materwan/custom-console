# Copy this file to `.env`. Every variable is optional unless stated otherwise;
# empty values are treated as "not set" and fall back to the default.

# --- reMarkable (required only to use the reMarkable backend) -----------------
# Full path to rmapi.exe
RMAPI_PATH=
# Where `cp -r reMarkable:/... <dir>` style syncs are stored (default: <data>/reMarkable_sync)
REMARKABLE_SYNC_PATH=

# --- Layout --------------------------------------------------------------------
# Root folder for logs, agent memory, workspaces, caches (default: <project>/data)
DATA_DIR=
# Name of the WSL distribution exposed as "/wsl-<name>/" (default: Ubuntu)
WSL_DISTRO=Ubuntu

# --- Ollama / agent ------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
AGENT_DEFAULT_MODEL=gemma4
# System prompt of the agent (default: <project>/config/agent_instructions.txt)
AGENT_INSTRUCTIONS_PATH=
# Tools needing a permission level <= this value are accepted without asking.
#   0 = always ask (except trivial tools)   1 = auto-accept reads   2 = auto-accept everything
AGENT_PERMISSION_LEVEL=1
AGENT_USER_ID=default_user
AGENT_SESSION_ID=console_session

# --- Moodle tools --------------------------------------------------------------
MOODLE_ENABLED=true
MOODLE_BASE_URL=https://moodle.epita.fr
# Playwright storage state (session cookies). Default: <project>/config/cookies/moodle_state.json
MOODLE_STATE_PATH=

# --- Email tool (registered only when SMTP_HOST is set) ------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
